{
  "version": 3,
  "policy_inputs": [
    ".github/workflows/tests.yml",
    "scripts/ci_plan.py",
    "scripts/ci_execute.py",
    "scripts/ci_dependencies.json",
    "scripts/ci_profile.py"
  ],
  "shared_inputs": [
    "src/**",
    "tests/conftest.py",
    "tests/support/**",
    "tests/**/conftest.py",
    "tests/**/__init__.py",
    "pyproject.toml",
    "uv.lock",
    ".python-version",
    ".github/**",
    "scripts/**",
    ".gitignore"
  ],
  "executable_inputs": [],
  "prose": [
    "AGENTS.md",
    "README.md",
    "docs/**/*.md",
    "docs/*.md"
  ],
  "notes": "All test_*.py and *_test.py files below the four ordinary test directories are current acceptance inputs. Live tests remain explicit opt-in outside those directories. Historical phase exports, SQLite minimum bindings, test counts and old node IDs are not acceptance gates. Runtime/schema and packaged v2 salvage contracts are shared src inputs. Named historical schema-hardening snapshots and validation evidence are report inputs; unclassified files conservatively select full acceptance.",
  "report_inputs": [
    "docs/ci-performance-baseline.json",
    "docs/ci-performance-results.json",
    "docs/ci-selection-results.json",
    "docs/validation/real-world/*.json",
    "docs/validation/synthetic/*.json",
    "docs/schema-hardening/column-conversion.csv",
    "docs/schema-hardening/conversion-contract.json",
    "docs/schema-hardening/current-schema.json",
    "docs/schema-hardening/index-probe.json",
    "docs/schema-hardening/invariant-contract.json",
    "docs/schema-hardening/proposal-core.sql",
    "docs/schema-hardening/source-access.json",
    "docs/schema-hardening/target-inventory.json",
    "docs/schema-hardening/target-schema.sql"
  ],
  "acceptance_directories": [
    "tests/unit",
    "tests/integration",
    "tests/e2e",
    "tests/packaging"
  ]
}
