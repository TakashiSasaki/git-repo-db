{
  "version": 3,
  "policy_inputs": [
    ".github/workflows/tests.yml",
    "scripts/ci_plan.py",
    "scripts/ci_execute.py",
    "scripts/ci_dependencies.json",
    "scripts/ci_profile.py",
    "scripts/ci_journal.py"
  ],
  "shared_inputs": [
    "src/**",
    "tests/conftest.py",
    "tests/support/**",
    "tests/**/conftest.py",
    "tests/**/__init__.py",
    "pyproject.toml",
    "uv.lock",
    ".python-version",
    ".github/**",
    "scripts/**",
    ".gitignore",
    "mkdocs.yml"
  ],
  "executable_inputs": [],
  "prose": [
    "AGENTS.md",
    "README.md",
    "docs/**/*.md",
    "docs/*.md",
    ".agents/skills/**/*.md"
  ],
  "notes": "All test_*.py and *_test.py files below the four ordinary test directories are current acceptance inputs. Live tests remain explicit opt-in outside those directories. Historical phase exports, SQLite minimum bindings, test counts and old node IDs are not acceptance gates. In Development mode, hosted CI executes lightweight static and smoke checks, while full pytest execution is primary locally. In Release mode, complete dual local and hosted execution is required. Named historical schema-hardening snapshots, validation evidence, and receipts are report inputs.",
  "report_inputs": [
    "docs/ci-performance-baseline.json",
    "docs/ci-performance-results.json",
    "docs/ci-selection-results.json",
    "docs/validation/real-world/*.json",
    "docs/validation/synthetic/*.json",
    "docs/validation/receipts/*.json",
    "docs/validation/evidence/*.json",
    "docs/schema-hardening/column-conversion.csv",
    "docs/schema-hardening/conversion-contract.json",
    "docs/schema-hardening/current-schema.json",
    "docs/schema-hardening/index-probe.json",
    "docs/schema-hardening/invariant-contract.json",
    "docs/schema-hardening/proposal-core.sql",
    "docs/schema-hardening/source-access.json",
    "docs/schema-hardening/target-inventory.json",
    "docs/schema-hardening/target-schema.sql"
  ],
  "acceptance_directories": [
    "tests/unit",
    "tests/integration",
    "tests/e2e",
    "tests/packaging"
  ]
}
