  "notes": {
    "common": "conftest imports CLI/Git helpers; support fixtures and migrations are shared. Unknown/shared changes widen to full.",
    "schema": "schema_contract reads DDL/current-schema/contract; invariant test reads inventory/CSV and referenced test AST; design/audit imports are transitive P2 dependencies.",
    "p2": "conversion imports schema_contract/schema_audit, hashes conversion modules, and reads source migrations. No legacy HTTP/Git E2E dependency.",
    "demo": "demo imports test_cache.expire, test_github_sync.configure and tests.support CLI/Git/HTTP fixtures.",
    "reports": "These explicit prose/reports are not application/schema fixture inputs. ci-performance-results JSON receives stdlib structure checks. baseline JSON is profiler input and is not prose.",
    "packaging": "CLI/resources/build metadata/locked wheels and packaging helpers determine assertions. Report bytes may appear in sdist but are not consumed by installed CLI or packaging assertions. Generated schema views are not prose."
  }
