{
  "sqlite": "3.51.3",
  "late_change_injected": true,
  "rejection": "CANCELLED",
  "git_commands": [
    {
      "started_after_cancellation": true,
      "argv": [
        "/bin/git",
        "--no-replace-objects",
        "--git-dir=/proc/self/fd/5",
        "-c",
        "core.fsmonitor=false",
        "-c",
        "core.hooksPath=/dev/null",
        "-c",
        "protocol.allow=never",
        "rev-parse",
        "--show-object-format=storage"
      ]
    }
  ],
  "fd_set_unchanged": true
}
