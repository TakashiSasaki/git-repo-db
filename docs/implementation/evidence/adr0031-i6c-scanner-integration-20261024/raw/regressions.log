                        git_input,
                        notes_source=notes_source,
                        work=budget,
                        progress=progress,
                    )
    
            def _prepared_core_unit(core_tx):
                if prepared is None:
                    return _core_unit(core_tx)
                with GitCore.for_transaction(core_tx) as core_cap:
                    prepared.apply(core_cap)
    
