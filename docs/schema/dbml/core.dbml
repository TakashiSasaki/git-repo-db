  Note: '''
    # git-repo-db Core Store (catalog.sqlite3)
    Schema Version: 21
    Tables: 70
    Physical Foreign Keys: 121
    DDL SHA-256: 8ee2631fe083e26cd0346bc71a8a5d1f4d7dab4bf661958d6406c885bc553ff0
    
